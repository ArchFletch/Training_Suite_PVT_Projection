[Unit]
Description=MLP License Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_GROUP__
WorkingDirectory=__WORKING_DIRECTORY__
EnvironmentFile=-__ENV_FILE__
Environment=MLP_LICENSE_SERVER_CONFIG=__CONFIG_PATH__
Environment=MLP_LICENSE_SERVER_RUNTIME_DIR=__DATA_DIR__
Environment=PYTHONUNBUFFERED=1
# ${...} braces are required. systemd unquotes the command line at parse time,
# so a bare $VAR is substituted and then SPLIT AT WHITESPACE into separate
# arguments -- "sh -lc" would receive only the interpreter path as its command
# string, launch python with no arguments, read EOF from stdin and exit 0.
# Type=simple plus exit 0 makes the unit report success while binding nothing.
ExecStart=/bin/sh -lc "exec ${MLP_LICENSE_SERVER_COMMAND}"
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=__DATA_DIR__ __LOG_DIR__

[Install]
WantedBy=multi-user.target
